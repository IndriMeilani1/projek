# Salin menjadi .env lalu sesuaikan.

# (Opsional) Alamat API Python. Kosongkan untuk mode mandiri (data tersimpan di HP,
# guru mengumpulkan file jawaban .json).
VITE_API_URL=

# Rahasia pembuat token tes. GANTI sebelum dipakai di sekolah.
VITE_TOKEN_SECRET=ganti-dengan-kata-rahasia-anda

# (Opsional) Tutor RMT berbasis AI Groq (https://console.groq.com/keys).
# PERINGATAN: nilai VITE_* ikut tertanam di file JavaScript hasil build, sehingga bisa dibaca
# siapa pun yang membuka aplikasi. Isi hanya untuk uji coba lokal. Untuk versi yang diunggah ke internet,
# kosongkan dan masukkan kunci lewat Mode Guru → Pengaturan di perangkat yang dipakai.
VITE_GROQ_API_KEY=
# Model Groq (default: openai/gpt-oss-20b, model open-weight tercepat di tier gratis).
VITE_GROQ_MODEL=openai/gpt-oss-20b
